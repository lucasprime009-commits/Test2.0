-- 防止重複執行
if getgenv().DungeonScriptLoaded then
    local oldUiExists = false
    local function checkUi(parent)
        if parent and parent:FindFirstChild("DungeonHubUI") then oldUiExists = true end
    end
    pcall(function()
        if typeof(gethui) == "function" then checkUi(gethui()) end
    end)
    pcall(function() checkUi(game:GetService("CoreGui")) end)
    pcall(function()
        local localPlayer = game:GetService("Players").LocalPlayer
        checkUi(localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui"))
    end)

    if oldUiExists then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "提示 hint",
            Text = "腳本已在運行中，請勿重複執行！ The script is already running; please do not execute it again!",
            Duration = 5
        })
        return
    end
    getgenv().DungeonScriptLoaded = nil
end
