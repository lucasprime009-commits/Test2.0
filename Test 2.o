local currentTween = nil
local FLY_EASING_STYLE = Enum.EasingStyle.Linear
local FLY_EASING_DIRECTION = Enum.EasingDirection.Out
local function flyTo(targetCFrame, customSpeed)
    if not hrp then return end
    local speed = customSpeed or CONFIG.TweenSpeed
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local time = distance / speed

    if time < 0.05 then hrp.CFrame = targetCFrame; return end
    if currentTween then currentTween:Cancel() end

    local info = TweenInfo.new(time, FLY_EASING_STYLE, FLY_EASING_DIRECTION)
    currentTween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    currentTween:Play()
end
local function stopFly()
    if currentTween then currentTween:Cancel(); currentTween = nil end
    pcall(function()
        if hrp then
            local flyBv = hrp:FindFirstChild("FlyVelocity")
            if flyBv then flyBv:Destroy() end
        end
    end)
end

local function ensureFlyVelocity()
    if not hrp then return end
    local flyBv = hrp:FindFirstChild("FlyVelocity")
    if not flyBv then
        flyBv = Instance.new("BodyVelocity")
        flyBv.Name = "FlyVelocity"
        flyBv.Velocity = Vector3.new(0, 0, 0)
        flyBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyBv.Parent = hrp
    end
end

----------------------------------------
-- One Shot 專用關卡
----------------------------------------
local ONE_SHOT_LEVELS = {
    [5] = true,
    [10] = true,
    [15] = true,
    [20] = true,
}

local function getAboveMonsterOffset()
    if Config.OneShotEnabled and hasOneShotAccess and ONE_SHOT_LEVELS[State.LockedLevel] then
        return 5
    end
    return CONFIG.AboveMonsterOffset
end

local function isM1FruitTool(item)
    if not item or not item:IsA("Tool") then return false end
    if item:GetAttribute("WeaponType") == "Demon Fruit" then return true end
    if item.ToolTip == "Blox Fruit" then return true end
    if item:FindFirstChild("LeftClickRemote") then return true end
    return false
end

local function getMaxCombo(tool)
    if not tool then return 5 end
    local lower = string.lower(tool.Name or "")
    if lower:find("trex", 1, true) then return 4 end
    if lower:find("pain", 1, true) then return 4 end
    if lower:find("control", 1, true) then return 4 end
    if lower:find("gas", 1, true) then return 5 end
    if lower:find("dragon", 1, true) then
        local char = player.Character
        return (char and char:FindFirstChild("DragonHybrid")) and 5 or 3
    end
    return 5
end

local function isOneShotFruit(name)
    if not name then return false end
    return string.lower(name):find("blade", 1, true) == nil
end

local function getM1FruitTool()
    local char = player.Character
    if not char then return nil end
    local fallback = nil
    for _, item in ipairs(char:GetChildren()) do
        if isM1FruitTool(item) then
            if isOneShotFruit(item.Name) then return item end
            if not fallback then fallback = item end
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if isM1FruitTool(item) then
                if isOneShotFruit(item.Name) then return item end
                if not fallback then fallback = item end
            end
        end
    end
    return fallback
end

local function autoEquipOneShotFruit()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local fruit = getM1FruitTool()
    if not fruit or not isOneShotFruit(fruit.Name) then return false end
    local equipped = hum:FindFirstChildOfClass("Tool")
    if equipped == fruit then return true end
    pcall(function()
        hum:EquipTool(fruit)
    end)
    return true
end

----------------------------------------
-- 自動裝備邏輯
----------------------------------------
local function equipByType(toolType)
    _G.AutoEquip_SelectedType = toolType
    if not _G.AutoEquip_Enabled then return end

    if Config.OneShotEnabled and hasOneShotAccess and ONE_SHOT_LEVELS[State.LockedLevel] then
        if autoEquipOneShotFruit() then return end
    end

    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == toolType then
            pcall(function()
                hum:EquipTool(tool)
            end)
            break
        end
    end
end

local function monitorCurrentTool()
    task.spawn(function()
        while scriptRunning do
            task.wait(0.1)
            pcall(function()
                if not _G.AutoEquip_Enabled then return end

                if Config.OneShotEnabled and hasOneShotAccess and ONE_SHOT_LEVELS[State.LockedLevel] then
                    equipByType(_G.AutoEquip_SelectedType)
                    return
                end

                if _G.AutoBird and _G.isHuntingBird and _G.HuntingType == "Tree" then
                    return
                end

                local char = player.Character
                if not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then return end

                local tool = hum:FindFirstChildOfClass("Tool")
                if not tool or tool.ToolTip ~= _G.AutoEquip_SelectedType then
                    equipByType(_G.AutoEquip_SelectedType)
                end
            end)
        end
    end)
end

monitorCurrentTool()

