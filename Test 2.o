local i18nRegistry = {}
local i18nCurrent = Config.Language or "zh"
local langToggleObj = nil

local function T(zh, en)
    if i18nCurrent == "en" then return en or zh end
    return zh
end

local function TranslateStatic(zh)
    if i18nCurrent == "en" then return TRANSLATIONS[zh] or zh end
    return zh
end

local function RegisterText(obj, zhText)
    if not obj then return end
    table.insert(i18nRegistry, { obj = obj, zh = zhText })
    obj.Text = TranslateStatic(zhText)
end

local function SetLanguage(lang)
    i18nCurrent = (lang == "en") and "en" or "zh"
    for _, entry in ipairs(i18nRegistry) do
        pcall(function()
            if entry.obj and entry.obj.Parent ~= nil then
                entry.obj.Text = TranslateStatic(entry.zh)
            end
        end)
    end
    if langToggleObj then
        pcall(function()
            langToggleObj:SetTitle((i18nCurrent == "en") and "Switch to Chinese" or "Switch to English")
        end)
    end
end

local function SaveSettings()
    if not isfolder or not writefile then return end
    pcall(function()
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        local dataToSave = {
            FastAttackMob = Config.FastAttackMob,
            FastAttackDelay = Config.FastAttackDelay,
            AttackRange = Config.AttackRange,
            AboveMonsterOffset = CONFIG.AboveMonsterOffset,
            M1FruitEnabled = Config.M1FruitEnabled,
            M1FruitDelay = Config.M1FruitDelay,
            OneShotEnabled = Config.OneShotEnabled,
            AutoStartDungeon = Config.AutoStartDungeon,
            AutoStartDelay = Config.AutoStartDelay,
            FollowPlayerEnabled = Config.FollowPlayerEnabled,
            FollowPlayerName = Config.FollowPlayerName,
            AutoExecute = Config.AutoExecute,
            DungeonDifficulty = Config.DungeonDifficulty,
            DragonGunM1 = Config.DragonGunM1,
            DragonGunDelay = Config.DragonGunDelay,
            AutoCameraShakeOff = Config.AutoCameraShakeOff,
            AutoFastMode = Config.AutoFastMode,
            Language = Config.Language,
            AutoFarm = State.AutoFarm,
            AutoBuso = State.AutoBuso,
            AutoV3 = State.AutoV3,
            AutoV4 = State.AutoV4,
            AutoEquip_Enabled = _G.AutoEquip_Enabled,
            AutoEquip_SelectedType = _G.AutoEquip_SelectedType,
            AutoCard_Enabled = _G.AutoCard_Enabled,
            AutoCard_ModeIndex = _G.AutoCard_ModeIndex,
            AutoCard_AltClick = _G.AutoCard_AltClick
        }
        writefile(FILE, HttpService:JSONEncode(dataToSave))
    end)
end

local function LoadSettings()
    if not isfile or not readfile then SaveSettings() return end
    pcall(function()
        local settingsPath = isfile(FILE) and FILE or (isfile(LEGACY_FILE) and LEGACY_FILE or nil)
        if settingsPath then
            local decoded = HttpService:JSONDecode(readfile(settingsPath))
            if decoded then
                if decoded.FastAttackMob ~= nil then Config.FastAttackMob = decoded.FastAttackMob end
                if decoded.FastAttackDelay ~= nil then Config.FastAttackDelay = decoded.FastAttackDelay end
                if decoded.AttackRange ~= nil then 
                    Config.AttackRange = decoded.AttackRange 
                    Config.NormalRange = decoded.AttackRange
                end
                if decoded.AboveMonsterOffset ~= nil then CONFIG.AboveMonsterOffset = decoded.AboveMonsterOffset end
                if decoded.M1FruitEnabled ~= nil then Config.M1FruitEnabled = decoded.M1FruitEnabled end
                if decoded.M1FruitDelay ~= nil then 
                    Config.M1FruitDelay = math.max(0, decoded.M1FruitDelay)
                end
                if decoded.OneShotEnabled ~= nil then Config.OneShotEnabled = decoded.OneShotEnabled end
                if decoded.AutoStartDungeon ~= nil then Config.AutoStartDungeon = decoded.AutoStartDungeon end
                if decoded.AutoStartDelay ~= nil then Config.AutoStartDelay = math.clamp(math.floor(decoded.AutoStartDelay + 0.5), 1, 60) end
                if decoded.FollowPlayerEnabled ~= nil then Config.FollowPlayerEnabled = decoded.FollowPlayerEnabled end
                if decoded.FollowPlayerName ~= nil then Config.FollowPlayerName = tostring(decoded.FollowPlayerName) end
                if decoded.AutoExecute ~= nil then Config.AutoExecute = decoded.AutoExecute end
                if decoded.DungeonDifficulty ~= nil then Config.DungeonDifficulty = decoded.DungeonDifficulty end
                if decoded.DragonGunM1 ~= nil then Config.DragonGunM1 = decoded.DragonGunM1 end
                if decoded.DragonGunDelay ~= nil then Config.DragonGunDelay = decoded.DragonGunDelay end
                if decoded.AutoCameraShakeOff ~= nil then Config.AutoCameraShakeOff = decoded.AutoCameraShakeOff end
                if decoded.AutoFastMode ~= nil then Config.AutoFastMode = decoded.AutoFastMode end
                if decoded.Language ~= nil then Config.Language = decoded.Language end
                if decoded.AutoFarm ~= nil then State.AutoFarm = decoded.AutoFarm end
                if decoded.AutoBuso ~= nil then State.AutoBuso = decoded.AutoBuso end
                if decoded.AutoV3 ~= nil then State.AutoV3 = decoded.AutoV3 end
                if decoded.AutoV4 ~= nil then State.AutoV4 = decoded.AutoV4 end
                if decoded.AutoEquip_Enabled ~= nil then _G.AutoEquip_Enabled = decoded.AutoEquip_Enabled end
                if decoded.AutoEquip_SelectedType ~= nil then _G.AutoEquip_SelectedType = decoded.AutoEquip_SelectedType end
                if decoded.AutoCard_Enabled ~= nil then _G.AutoCard_Enabled = decoded.AutoCard_Enabled end
                if decoded.AutoCard_ModeIndex ~= nil then _G.AutoCard_ModeIndex = decoded.AutoCard_ModeIndex end
                if decoded.AutoCard_AltClick ~= nil then _G.AutoCard_AltClick = decoded.AutoCard_AltClick end
            end
        else
            SaveSettings()
        end
    end)
    SetLanguage(Config.Language)
end

