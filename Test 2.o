    addToggle("關閉相機震動", function() return Config.AutoCameraShakeOff end, function(v) Config.AutoCameraShakeOff = v end, function(v)
        if v then
            SetCameraShakeEnabled(false)
            pcall(function() ReplicatedStorage.Remotes.ChangeSetting:FireServer("CameraShake", false) end)
        else
            SetCameraShakeEnabled(true)
            pcall(function() ReplicatedStorage.Remotes.ChangeSetting:FireServer("CameraShake", true) end)
        end
    end)
    addToggle("快速模式", function() return Config.AutoFastMode end, function(v) Config.AutoFastMode = v end, function(v)
        task.spawn(function() pcall(function() SetFastMode(v) end) end)
    end)
    addToggle("自動開始", function() return Config.AutoStartDungeon end, function(v) Config.AutoStartDungeon = v end, function(v)
        autoStartDelayStart = os.clock()
        autoStartDelayDone = false
        syncAutoExecForAutomation()
    end)
    addToggle("跟隨玩家", function() return Config.FollowPlayerEnabled end, function(v) Config.FollowPlayerEnabled = v end, function()
        syncAutoExecForAutomation()
    end)

    local FOLLOW_SELF_OPTION = "自己（本帳號／啟動者）"
    local function getFollowPlayerOptions()
        local names = { FOLLOW_SELF_OPTION }
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then table.insert(names, other.Name) end
        end
        table.sort(names)
        if Config.FollowPlayerName ~= "" and Config.FollowPlayerName ~= "__SELF__"
            and not table.find(names, Config.FollowPlayerName) then
            table.insert(names, Config.FollowPlayerName)
            table.sort(names)
        end
        return names
    end
    local function getFollowPlayerDisplay()
        return (Config.FollowPlayerName == "" or Config.FollowPlayerName == "__SELF__")
            and FOLLOW_SELF_OPTION or Config.FollowPlayerName
    end

    local followPlayerDropdown = makeDropdown(
        leftCol,
        "選擇跟隨玩家",
        getFollowPlayerOptions(),
        getFollowPlayerDisplay(),
        function(value)
            Config.FollowPlayerName = (value == FOLLOW_SELF_OPTION) and "__SELF__" or value
            autoStartDelayStart = os.clock()
            autoStartDelayDone = false
            SaveSettings()
        end
    )
    local function refreshFollowPlayerDropdown()
        if followPlayerDropdown then
            followPlayerDropdown.SetValues(getFollowPlayerOptions())
            followPlayerDropdown.SetValue(getFollowPlayerDisplay())
        end
    end
    addConnection(Players.PlayerAdded:Connect(refreshFollowPlayerDropdown))
    addConnection(Players.PlayerRemoving:Connect(refreshFollowPlayerDropdown))

    local function uiNotify(title, text)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = text, Duration = 4 })
        end)
    end

    local autoExecToggleObj = addToggle("自動執行腳本", function() return Config.AutoExecute end, function(v) Config.AutoExecute = v end, function(v)
        if not autoExecSupported then return end
        local notifyTitle = T("自動執行腳本", "Auto Execute Script")
        if v then
            if autoExecSetFile(true) then
                uiNotify(notifyTitle, T("已開啟，換服後會自動重新載入", "Enabled - reloads automatically"))
            else
                Config.AutoExecute = false
                uiNotify(notifyTitle, T("開啟失敗，請確認執行器支援", "Failed - executor not supported"))
            end
        else
            autoExecSetFile(false)
            uiNotify(notifyTitle, T("已關閉", "Disabled"))
        end
    end, true)

    if not autoExecSupported then
        Config.AutoExecute = false
        autoExecToggleObj:SetTitle(TranslateStatic("🔒 自動執行腳本 (執行器不支援)"))
        autoExecToggleObj:SetLocked(true)
    end

    makeDropdown(rightCol, "裝備類型", { "Melee", "Blox Fruit", "Sword", "Gun" }, _G.AutoEquip_SelectedType, function(v)
        _G.AutoEquip_SelectedType = v
        if _G.AutoEquip_Enabled then equipByType(v) end
        SaveSettings()
    end)

    makeDropdown(rightCol, "卡片模式", modeNames, modeNames[_G.AutoCard_ModeIndex] or modeNames[1], function(v)
        for i, name in ipairs(modeNames) do
            if name == v then _G.AutoCard_ModeIndex = i break end
        end
        SaveSettings()
    end)

    makeDropdown(rightCol, "選擇難度", { "Normal", "Hard", "Challenge" }, Config.DungeonDifficulty or "Normal", function(v)
        Config.DungeonDifficulty = v
        SaveSettings()
    end)

    fruitM1SliderObj = makeSlider(rightCol, "果實 M1 延遲", 0, 0.5, 0.01, Config.M1FruitDelay or 0, function(v)
        Config.M1FruitDelay = v
        SaveSettings()
    end)

    dragonM1SliderObj = makeSlider(rightCol, "龍炮延遲", 0, 2, 0.05, Config.DragonGunDelay or 0, function(v)
        Config.DragonGunDelay = v
        SaveSettings()
    end)

    makeSlider(rightCol, "攻速延遲", 0, 1, 0.01, Config.FastAttackDelay or 0, function(v)
        Config.FastAttackDelay = v
        SaveSettings()
    end)

    makeSlider(rightCol, "攻擊範圍", 50, 2000, 10, Config.AttackRange or 250, function(v)
        Config.AttackRange = v
        Config.NormalRange = v
        SaveSettings()
    end)

    makeSlider(rightCol, "怪頭高度", 0, 50, 1, CONFIG.AboveMonsterOffset or 4, function(v)
        CONFIG.AboveMonsterOffset = v
        SaveSettings()
    end)

    makeSlider(rightCol, "飛往控制台延遲 (秒)", 1, 60, 1, Config.AutoStartDelay or 15, function(v)
        Config.AutoStartDelay = math.clamp(math.floor(v + 0.5), 1, 60)
        SaveSettings()
    end)

    ----------------------------------------
    -- 放大版浮動收納按鈕
    ----------------------------------------
    local openBtn = new("TextButton", {
        Name = "OpenButton",
        Text = "",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        Size = UDim2.fromOffset(165, 52),
        Position = UDim2.new(0.03, 0, 0.35, 0),
        AnchorPoint = Vector2.new(0, 0),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        Visible = false,
        AutoButtonColor = false,
        Parent = ScreenGui,
    })
    addCorner(openBtn, 14)
    addStroke(openBtn, Theme.Accent, 0.2, 1.5)

    openScale = new("UIScale", { Parent = openBtn })
    openScale.Scale = openBaseScale

    local openAccentBar = new("Frame", {
        Size = UDim2.fromOffset(6, 28),
        Position = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = openBtn,
    })
    addCorner(openAccentBar, 3)

    RegisterText(new("TextLabel", {
        Text = "Siddhant z hub",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(28, 9),
        Size = UDim2.new(1, -34, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = openBtn,
    }), "Siddhant z hub")

    local openStatus = new("TextLabel", {
        Text = T("待機中", "Idle"),
        Font = Enum.Font.Gotham,
        TextSize = 11.5,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(28, 27),
        Size = UDim2.new(1, -34, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = openBtn,
    })

    updateFloatingStatus = function(t)
        openStatus.Text = tostring(t):gsub("關卡：", ""):gsub("狀態：", ""):gsub("Floor: ", ""):gsub("Status: ", "")
    end

    local function showWindowAnimated()
        if Main.Visible or isAnimating then return end
        isAnimating = true

        Main.Visible = true
        uiScale.Scale = baseScale * 0.3
        local pop = TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })
        pop.Completed:Connect(function()
            uiScale.Scale = baseScale
            isAnimating = false
        end)
        pop:Play()

        openBtn.Visible = true
        local shrink = TweenService:Create(openScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
        shrink.Completed:Connect(function()
            openBtn.Visible = false
            openScale.Scale = openBaseScale
        end)
        shrink:Play()
    end

    local function hideWindowAnimated()
        if not Main.Visible or isAnimating then return end
        isAnimating = true

        local shrink = TweenService:Create(uiScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = baseScale * 0.05 })
        shrink.Completed:Connect(function()
            Main.Visible = false
            uiScale.Scale = baseScale
        end)
        shrink:Play()

        openBtn.Visible = true
        openScale.Scale = 0
        local pop = TweenService:Create(openScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = openBaseScale })
        pop.Completed:Connect(function() isAnimating = false end)
        pop:Play()
    end

    local function enableAnimatedDrag(handle, target, onClick)
        local dragging = false
        local moved = false
        local dragStart, startPos
        local dragTween = nil

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                moved = false
                dragStart = input.Position
                startPos = target.Position
            end
        end)

        table.insert(uiConnections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragging and not moved and onClick then onClick() end
                dragging = false
            end
        end))

        table.insert(uiConnections, UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then moved = true end
                local s = uiScale.Scale
                local targetPos = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X / s,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y / s
                )
                if dragTween then dragTween:Cancel() end
                dragTween = TweenService:Create(target, TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Position = targetPos })
                dragTween:Play()
            end
        end))
    end

    enableAnimatedDrag(TopBar, Main)
    enableAnimatedDrag(openBtn, openBtn, function() showWindowAnimated() end)

    minimizeBtn.Activated:Connect(function() hideWindowAnimated() end)

    -- 視窗大小調整
    local resizeGrip = new("Frame", {
        Name = "ResizeGrip",
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -4, 1, -4),
        AnchorPoint = Vector2.new(1, 1),
        BackgroundTransparency = 1,
        Parent = Main,
    })
    for i = 1, 3 do
        local dot = new("Frame", {
            Size = UDim2.fromOffset(3.5, 3.5),
            Position = UDim2.fromOffset(i * 4.5, 16 - i * 4.5),
            BackgroundColor3 = Theme.SubText,
            BackgroundTransparency = 0.35,
            BorderSizePixel = 0,
            Parent = resizeGrip,
        })
        addCorner(dot, 2)
    end

    local MIN_W, MIN_H = 500, 380
    local MAX_W, MAX_H = 1200, 900
    local resizing = false
    local resizeStart, startSize

    resizeGrip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = Vector2.new(Main.Size.X.Offset, Main.Size.Y.Offset)
        end
    end)

    table.insert(uiConnections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end))

    table.insert(uiConnections, UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - resizeStart
            local s = uiScale.Scale
            local maxW, maxH = MAX_W, MAX_H
            local cam = workspace.CurrentCamera
            if cam then
                maxW = math.min(MAX_W, cam.ViewportSize.X / s - 20)
                maxH = math.min(MAX_H, cam.ViewportSize.Y / s - 20)
            end
            local w = math.clamp(startSize.X + delta.X / s, MIN_W, maxW)
            local h = math.clamp(startSize.Y + delta.Y / s, MIN_H, maxH)
            Main.Size = UDim2.fromOffset(w, h)
            updateContentSize()
        end
    end))

    closeBtn.Activated:Connect(function()
        stopAllFeatures()
        ScreenGui:Destroy()
    end)

    ScreenGui.Destroying:Connect(stopAllFeatures)

    table.insert(uiConnections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            if Main.Visible then hideWindowAnimated() else showWindowAnimated() end
        end
    end))

    local BringZero = Vector3.new(0, 0, 0)
    local SupportsAssemblyVelocity = pcall(function() return workspace.Terrain.AssemblyLinearVelocity ~= nil end)
    local function freezePlayerPhysics(char)
        if not char then return end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Velocity = BringZero
                part.RotVelocity = BringZero
                if SupportsAssemblyVelocity then
                    part.AssemblyLinearVelocity = BringZero
                    part.AssemblyAngularVelocity = BringZero
                end
            end
        end
    end

    addConnection(RunService.Heartbeat:Connect(function()
        if State.AutoFarm and character and hrp and humanoid and humanoid.Health > 0 then
            freezePlayerPhysics(character)
        end
    end))

    return statusLabel
end

local uiOk, statusLabel = pcall(buildUI)
if not uiOk or not statusLabel then
    warn("UI 建立失敗：", tostring(statusLabel))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "UI 錯誤",
            Text = "介面建立失敗，請檢查執行器相容性。",
            Duration = 5,
        })
    end)
    getgenv().DungeonScriptLoaded = nil
    return
end

local dungeonTeleporting = false
local lastDungeonTeleport = 0
local enterRoomTime = tick()

local WIDE_SCAN_RANGE = 5000
local WIDE_SCAN_TRIGGER = 6
local WIDE_SCAN_WAIT = 0
local clearPhaseStart = 0
local wideScanTarget = nil
local wideScanTime = 0

local function mainLoop()
    while scriptRunning do
        task.wait(0.15)
        getRef()

        if not character or not hrp or not humanoid or humanoid.Health <= 0 then
            State.FindingNextFloor = false
            State.StatusText = T("等待角色重生...", "Waiting for respawn...")
            statusLabel:SetTitle(T("關卡：第 ", "Floor: ") .. tostring(State.LockedLevel) .. T(" 關 | 狀態：", " | Status: ") .. State.StatusText)
            continue
        end

        local map = workspace:FindFirstChild("Map")
        local dungeon = map and map:FindFirstChild("Dungeon")
        if dungeon then
            local nearestLevel, nearestDist = nil, 600
            for _, lv in pairs(dungeon:GetChildren()) do
                local n = tonumber(lv.Name)
                local floor = lv:FindFirstChild("Floor") or lv:FindFirstChildWhichIsA("BasePart")
                if n and floor then
                    local d = (hrp.Position - floor.Position).Magnitude
                    if d < nearestDist then
                        nearestDist = d
                        nearestLevel = n
                    end
                end
            end
            if nearestLevel and State.LockedLevel ~= nearestLevel then
                State.LockedLevel = nearestLevel
                enterRoomTime = tick()
                State.WideScan = false
                clearPhaseStart = 0
                wideScanTarget = nil
            end
        end

        doBuffs()
        callV4()

        if followingPlayerNow then
            State.StatusText = T("跟隨玩家中...", "Following selected player...")
        elseif State.AutoFarm then
            local ef = workspace:FindFirstChild("Enemies")
            local closest, minDist = nil, math.huge
            local priorityTargets = {}
            local scanRange = State.WideScan and WIDE_SCAN_RANGE or 600

            if ef then
                for _, npc in ipairs(ef:GetChildren()) do
                    if npc.Name == "Blank Buddy" or isShadow(npc.Name) then continue end
                    local npcHum  = npc:FindFirstChild("Humanoid")
                    local npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                    if npcHum and npcHum.Health > (Config.HealthMobThreshold or 0) and npcRoot then
                        local d = (npcRoot.Position - hrp.Position).Magnitude
                        if npc.Name == "PropHitboxPlaceholder" and d <= scanRange then
                            table.insert(priorityTargets, npcRoot)
                        end
                        if d < minDist and d <= scanRange then
                            minDist = d
                            closest = npcRoot
                        end
                    end
                end
            end

            local target = (#priorityTargets > 0) and priorityTargets[1] or closest
            State.FindingNextFloor = (target == nil) and ((tick() - enterRoomTime) >= CONFIG.EnterRoomWaitTime)

            if target then
                enterRoomTime = 0
                clearPhaseStart = 0
                pcall(function() target.CanCollide = false end)

                ensureFlyVelocity()

                local canFly = true
                if State.WideScan then
                    if wideScanTarget ~= target then
                        wideScanTarget = target
                        wideScanTime = tick()
                    end
                    local waitLeft = WIDE_SCAN_WAIT - (tick() - wideScanTime)
                    if waitLeft > 0 then
                        canFly = false
                        State.StatusText = T("偵測到遠處怪物，等待 ", "Far monster detected, waiting ") .. string.format("%.1f", waitLeft) .. T(" 秒...", "s...")
                    end
                else
                    wideScanTarget = nil
                end

                if canFly then
                    local targetPos = target.CFrame.Position + Vector3.new(0, getAboveMonsterOffset(), 0)
                    flyTo(CFrame.new(targetPos), CONFIG.TweenSpeed)
                    State.StatusText = T("飛往目標: ", "Flying to: ") .. (target.Parent and target.Parent.Name or "?")
                end
            else
                if clearPhaseStart == 0 then clearPhaseStart = tick() end
                if not State.WideScan and (tick() - clearPhaseStart) >= WIDE_SCAN_TRIGGER then
                    State.WideScan = true
                end

                local timeSinceEnter = tick() - enterRoomTime
                if timeSinceEnter < CONFIG.EnterRoomWaitTime then
                    local timeLeft = string.format("%.1f", CONFIG.EnterRoomWaitTime - timeSinceEnter)
                    State.StatusText = T("已進入第 ", "Entered floor ") .. tostring(State.LockedLevel) .. T(" 關，等待生怪 (", ", waiting for mobs (") .. timeLeft .. "s)..."
                    ensureFlyVelocity()
                else
                    if not dungeonTeleporting then
                        local mapObj = workspace:FindFirstChild("Map")
                        local dungeonObj = mapObj and mapObj:FindFirstChild("Dungeon")
                        local targetExit, exitMinDist = nil, math.huge
                        local maxExitDist = (State.LockedLevel == 15) and 2500 or 1000

                        if dungeonObj then
                            for _, level in ipairs(dungeonObj:GetChildren()) do
                                if tonumber(level.Name) then
                                    local tp = level:FindFirstChild("ExitTeleporter")
                                    if tp then
                                        local root = tp:FindFirstChild("Root") or tp:FindFirstChildWhichIsA("BasePart")
                                        if root then
                                            local d = (hrp.Position - root.Position).Magnitude
                                            if d < exitMinDist and d < maxExitDist then
                                                exitMinDist = d
                                                targetExit = root
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if targetExit and tick() - lastDungeonTeleport >= 2 then
                            dungeonTeleporting = true
                            lastDungeonTeleport = tick()
                            enterRoomTime = tick()
                            flyTo(targetExit.CFrame, CONFIG.TweenSpeed)
                            task.delay(1.2, function() dungeonTeleporting = false end)
                            State.StatusText = T("飛往下一關出口...", "Flying to next floor exit...")
                        else
                            pcall(function()
                                local flyBv = hrp:FindFirstChild("FlyVelocity")
                                if flyBv then flyBv:Destroy() end
                            end)
                            if autoStartFlying then
                                State.StatusText = T("飛往開始點...", "Flying to start pad...")
                            else
                                stopFly()
                                State.StatusText = State.LockedLevel == 15 and T("第15關Boss打完，擴大搜尋出口中...", "Floor 15 boss cleared...") or T("尋找出口中...", "Searching for exit...")
                            end
                        end
                    end
                end
            end
        else
            State.FindingNextFloor = false
            State.WideScan = false
            clearPhaseStart = 0
            wideScanTarget = nil
            if followingPlayerNow then
                State.StatusText = T("跟隨玩家中...", "Following selected player...")
            elseif autoStartFlying then
                State.StatusText = T("飛往開始點...", "Flying to start pad...")
            else
                pcall(function()
                    local flyBv = hrp:FindFirstChild("FlyVelocity")
                    if flyBv then flyBv:Destroy() end
                end)
                stopFly()
                State.StatusText = (Config.FastAttackMob or Config.M1FruitEnabled or Config.DragonGunM1) and T("攻擊待命", "Attack Ready") or T("待機中", "Idle")
            end
        end
        statusLabel:SetTitle(T("關卡：第 ", "Floor: ") .. tostring(State.LockedLevel) .. T(" 關 | 狀態：", " | Status: ") .. State.StatusText)
    end
end

task.spawn(mainLoop)
