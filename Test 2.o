    local function topButton(text, xOffset, bgColor)
        local btn = new("TextButton", {
            Text = text,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextColor3 = Theme.Text,
            Size = UDim2.fromOffset(34, 34),
            Position = UDim2.new(1, xOffset, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = bgColor,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Parent = TopBar,
        })
        addCorner(btn, 10)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = bgColor:Lerp(Color3.fromRGB(255, 255, 255), 0.15)}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = bgColor}):Play()
        end)
        return btn
    end

