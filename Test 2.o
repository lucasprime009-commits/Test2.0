            1 / contentFactor, -76 / contentFactor
        )
    end
    updateContentSize()

    local orderCounter = 0
    local function nextOrder()
        orderCounter = orderCounter + 1
        return orderCounter
    end

    local function makeColumn(alignRight)
        local col = new("ScrollingFrame", {
            Size = UDim2.new(0.5, -8, 1, 0),
            Position = alignRight and UDim2.new(1, 0, 0, 0) or UDim2.new(0, 0, 0, 0),
            AnchorPoint = alignRight and Vector2.new(1, 0) or Vector2.new(0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Parent = Content,
        })
        new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = col })
        return col
    end

    local leftCol = makeColumn(false)
    local rightCol = makeColumn(true)

    local function addSectionHeader(col, title)
        local lbl = new("TextLabel", {
            Text = title,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 24),
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = nextOrder(),
            Parent = col,
        })
        RegisterText(lbl, title)
        return lbl
    end

    local function newRow(col, height)
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, height),
            BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 0.2, -- 稍微透明讓背景透過去
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
            Parent = col,
        })
        addCorner(row, 10)
        addStroke(row, Theme.Stroke, 0.4, 1.5)
        return row
    end

    ----------------------------------------
    -- 互動元件：開關、標籤、下拉與滑桿
    ----------------------------------------
    local function makeToggle(col, title, default, callback, skipI18n, noTruncate)
        local isLocked = false
        local state = default == true

        local row = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 42),
            BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = nextOrder(),
            Parent = col,
        })
        addCorner(row, 10)
        addStroke(row, Theme.Stroke, 0.4, 1.5)

        local titleLabel = new("TextLabel", {
            Text = title,
            Font = Enum.Font.GothamMedium,
            TextSize = 13.5,
            TextColor3 = Theme.Text,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 0),
            Size = UDim2.new(1, -84, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = noTruncate and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
            TextScaled = noTruncate and true or false,
            Parent = row,
        })
        if noTruncate then
            new("UITextSizeConstraint", { MaxTextSize = 13.5, Parent = titleLabel })
        end
        if not skipI18n then
            RegisterText(titleLabel, title)
        end

        local switch = new("Frame", {
            Size = UDim2.fromOffset(46, 24),
            Position = UDim2.new(1, -14, 0.5, 0),
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundColor3 = Theme.Off,
            BorderSizePixel = 0,
            Parent = row,
        })
        addCorner(switch, 12)

        local knob = new("Frame", {
            Size = UDim2.fromOffset(18, 18),
            Position = UDim2.new(0, 3, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
            Parent = switch,
        })
        addCorner(knob, 9)

        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        local bgTweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

        local function render()
            if isLocked then
                TweenService:Create(switch, bgTweenInfo, { BackgroundColor3 = Theme.Locked }):Play()
                TweenService:Create(knob, tweenInfo, { Position = UDim2.new(0, 3, 0.5, 0) }):Play()
                row.BackgroundColor3 = Theme.Locked
                titleLabel.TextColor3 = Theme.SubText
            else
                TweenService:Create(switch, bgTweenInfo, { BackgroundColor3 = state and Theme.On or Theme.Off }):Play()
                TweenService:Create(knob, tweenInfo, { Position = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }):Play()
                row.BackgroundColor3 = Theme.Panel
                titleLabel.TextColor3 = Theme.Text
            end
        end
        render()

        row.Activated:Connect(function()
            if isLocked then return end
            state = not state
            render()
            callback(state)
        end)

        local toggleObj = {}
        function toggleObj:SetTitle(newTitle) titleLabel.Text = newTitle end
        function toggleObj:SetLocked(locked)
            isLocked = locked
            if locked then
                state = false
                callback(false)
            end
            render()
        end
        function toggleObj:SetVisible(visible) row.Visible = visible end
        return toggleObj
    end

    local updateFloatingStatus = nil

    local function makeLabel(col, text, height)
        local row = newRow(col, height or 46)
        local lbl = new("TextLabel", {
            Text = text,
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextColor3 = Theme.SubText,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 0),
            Size = UDim2.new(1, -28, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row,
        })
        local obj = {}
        function obj:SetTitle(t)
            lbl.Text = t
            if updateFloatingStatus then updateFloatingStatus(t) end
        end
        return obj
    end

    local function makeDropdown(col, title, values, default, callback)
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 42),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Panel,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            LayoutOrder = nextOrder(),
            Parent = col,
        })
        addCorner(row, 10)
        addStroke(row, Theme.Stroke, 0.4, 1.5)
        new("UIPadding", { PaddingBottom = UDim.new(0, 8), Parent = row })

        local titleLbl = new("TextLabel", {
            Text = title,
            Font = Enum.Font.GothamMedium,
            TextSize = 13.5,
            TextColor3 = Theme.Text,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 0),
            Size = UDim2.new(0.5, -28, 0, 42),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row,
        })
        RegisterText(titleLbl, title)

        local current = tostring(default or values[1])
        local valueLabel = new("TextLabel", {
            Text = current,
            Font = Enum.Font.Gotham,
            TextSize = 12.5,
            TextColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -38, 0, 0),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.new(0.5, -60, 0, 42),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row,
        })
        local arrow = new("TextLabel", {
            Text = "▼",
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextColor3 = Theme.SubText,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -14, 0, 0),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.fromOffset(20, 42),
            Parent = row,
        })

        local listHolder = new("Frame", {
            Position = UDim2.fromOffset(10, 46),
            Size = UDim2.new(1, -20, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
            Parent = row,
        })
        new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = listHolder })

        local open = false
        local optionButtons = {}
        local function refreshColors()
            for _, btn in ipairs(optionButtons) do
                btn.BackgroundColor3 = (btn.Text == current) and Theme.AccentDim or Theme.Element
                btn.TextColor3 = (btn.Text == current) and Theme.Accent or Theme.SubText
            end
        end

        local function addOption(i, v)
            local btn = new("TextButton", {
                Text = tostring(v),
                Font = Enum.Font.Gotham,
                TextSize = 12.5,
                TextColor3 = Theme.SubText,
                BackgroundColor3 = Theme.Element,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 32),
                AutoButtonColor = false,
                LayoutOrder = i,
                Parent = listHolder,
            })
            addCorner(btn, 7)
            table.insert(optionButtons, btn)
            btn.Activated:Connect(function()
                current = btn.Text
                valueLabel.Text = btn.Text
                refreshColors()
                open = false
                listHolder.Visible = false
                arrow.Text = "▼"
                callback(btn.Text)
            end)
        end
        for i, v in ipairs(values) do addOption(i, v) end
        refreshColors()

        local header = new("TextButton", {
            Text = "",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 42),
            Parent = row,
        })
        header.Activated:Connect(function()
            open = not open
            listHolder.Visible = open
            arrow.Text = open and "▲" or "▼"
        end)

        return {
            SetValues = function(newValues)
                for _, btn in ipairs(optionButtons) do
                    if btn and btn.Parent then btn:Destroy() end
                end
                table.clear(optionButtons)
                for i, value in ipairs(newValues or {}) do addOption(i, value) end
                refreshColors()
            end,
            SetValue = function(value)
                current = tostring(value or "")
                valueLabel.Text = current
                refreshColors()
            end,
        }
    end

    local function makeSlider(col, title, min, max, step, default, callback)
        local isLocked = false
        local row = newRow(col, 62)
        row.Active = true

        local titleLbl = new("TextLabel", {
            Text = title,
            Font = Enum.Font.GothamMedium,
            TextSize = 13.5,
            TextColor3 = Theme.Text,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 8),
            Size = UDim2.new(1, -90, 0, 18),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = row,
        })
        RegisterText(titleLbl, title)

        local valueLabel = new("TextLabel", {
            Text = "",
            Font = Enum.Font.GothamBold,
            TextSize = 12.5,
            TextColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -14, 0, 8),
            AnchorPoint = Vector2.new(1, 0),
            Size = UDim2.fromOffset(70, 18),
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = row,
        })

        local track = new("Frame", {
            Position = UDim2.new(0, 14, 0, 38),
            Size = UDim2.new(1, -28, 0, 8),
            BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0,
            Active = true,
            Parent = row,
        })
        addCorner(track, 4)

        local fill = new("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Parent = track,
        })
        addCorner(fill, 4)

        local knob = new("Frame", {
            Size = UDim2.fromOffset(16, 16),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
            Parent = track,
        })
        addCorner(knob, 8)

        local function formatValue(v)
            return string.format("%g", math.floor(v * 100 + 0.5) / 100)
        end

        local currentValue = default == nil and min or default

        local function setValue(v, fire)
            v = math.clamp(v, min, max)
            if step and step > 0 then
                v = math.floor(v / step + 0.5) * step
            end
            v = math.floor(v * 1000 + 0.5) / 1000
            v = math.clamp(v, min, max)

            currentValue = v
            local pct = (max > min) and (v - min) / (max - min) or 0
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valueLabel.Text = formatValue(v)
            if fire then callback(v) end
        end

        local dragging = false
        local function applyFromX(x)
            if isLocked then return end
            local sizeX = track.AbsoluteSize.X
            if sizeX <= 0 then return end
            local pct = math.clamp((x - track.AbsolutePosition.X) / sizeX, 0, 1)
            setValue(min + (max - min) * pct, true)
        end

        row.InputBegan:Connect(function(input)
            if isLocked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                applyFromX(input.Position.X)
            end
        end)
        table.insert(uiConnections, UserInputService.InputChanged:Connect(function(input)
            if dragging and not isLocked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                applyFromX(input.Position.X)
            end
        end))
        table.insert(uiConnections, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))

        setValue(default == nil and min or default, false)

        local sliderObj = {}
        function sliderObj:SetTitle(t) titleLbl.Text = t end
        function sliderObj:SetMin(newMin)
            if newMin == min then return end
            min = newMin
            setValue(currentValue, true)
        end
        function sliderObj:SetLocked(locked)
            isLocked = locked
            if locked then
                row.BackgroundColor3 = Theme.Locked
                titleLbl.TextColor3 = Theme.SubText
                valueLabel.TextColor3 = Theme.SubText
                fill.BackgroundColor3 = Theme.Off
            else
                row.BackgroundColor3 = Theme.Panel
                titleLbl.TextColor3 = Theme.Text
                valueLabel.TextColor3 = Theme.Accent
                fill.BackgroundColor3 = Theme.Accent
            end
        end
        return sliderObj
    end

